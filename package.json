{
  "name": "cortico-world-extsearch",
  "version": "0.2.0",
  "type": "module",
  "description": "Search the Cortico extension market, choose candidates in conversation and save local favorites",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "extension-search"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "扩展市场搜索",
    "tags": [
      "internet",
      "injection-risk"
    ],
    "locales": {
      "zh": {
        "displayName": "扩展市场搜索",
        "description": "搜索 Cortico 扩展市场，介绍候选后选择深入了解的扩展，并将插件收藏到本地卡片页。"
      },
      "en": {
        "displayName": "Extension Market Search",
        "description": "Search the Cortico extension market, choose a candidate to discuss and save extensions in a local favorites page."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "describe.json",
    "dist",
    "README_zh.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "build": "esbuild webui/client.ts --bundle --format=esm --outfile=dist/webui.js",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "@types/jsdom": "^21.1.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moya-Doc/cortico-world-extsearch.git"
  },
  "homepage": "https://github.com/Moya-Doc/cortico-world-extsearch#readme",
  "bugs": {
    "url": "https://github.com/Moya-Doc/cortico-world-extsearch/issues"
  },
  "author": {
    "name": "Moya-Doc",
    "url": "https://github.com/Moya-Doc"
  }
}
